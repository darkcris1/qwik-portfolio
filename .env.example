# Copy to .env for local dev, and set the same keys in Vercel project settings.

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Bypasses RLS, used only by the scheduled post endpoint. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google account allowed into /admin
ADMIN_EMAIL=you@gmail.com

# Contact form mailer (Gmail address + app password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# Scheduled AI post every 3 days (/cron/weekly-post)
# Shared with GitHub secret CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional, comma-separated models tried in order when Gemini is busy
GEMINI_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# Optional, "published" (default) or "draft" to review posts in /admin first
POST_STATUS=published

# GitHub repo settings (not read by the app):
#   secret   CRON_SECRET  same value as above
#   secret   GEMINI_API_KEY  free key from https://aistudio.google.com/apikey (the Action calls Gemini)
#   variable SITE_URL     e.g. https://yoursite.com (no trailing slash)
