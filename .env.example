# Copy to .env for local dev, and set the same keys in Vercel project settings.

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Bypasses RLS, used only by the weekly post endpoint. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google account allowed into /admin
ADMIN_EMAIL=you@gmail.com

# Contact form mailer (Gmail address + app password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# Weekly AI post (/cron/weekly-post)
# Shared with GitHub secret CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
# Optional, "draft" (default) or "published"
POST_STATUS=draft

# GitHub repo settings (not read by the app):
#   secret   CRON_SECRET  same value as above
#   variable SITE_URL     e.g. https://yoursite.com (no trailing slash)
